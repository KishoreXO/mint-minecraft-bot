# Copy this file to .env and fill in the first block. Everything else is optional.

# --- The world ------------------------------------------------------------
MC_HOST=localhost
# The LAN port. Minecraft picks a new one every time you "Open to LAN".
MC_PORT=25565
# The bot's name in the world.
BOT_NAME=Mint

# --- Decisions --------------------------------------------------------------
# API key for Jev (TypeSafe), the model the bot asks for judgement calls such as
# "fight or flee". Without a key the bot still plays, using its built-in rules.
TYPESAFE_API_KEY=

# --- Joining a real server instead of a LAN world ---------------------------
# MC_AUTH=microsoft            offline (default) for LAN; microsoft for online servers
# MC_EMAIL=you@example.com     the Microsoft account to sign in with (microsoft only)
# MC_VERSION=1.21.9            force a version; auto-detected when unset
# MC_CONNECT_TIMEOUT_MS=60000
# MC_VIEW_DISTANCE=normal      chunks to request: tiny, short, normal, far

# --- The dashboard (http://localhost:3000) ----------------------------------
# MC_DASHBOARD_PORT=3000       0 turns the website off
# MC_VIEWER=on                 off drops the 3D view and keeps the rest (saves memory)
# MC_VIEWER_DISTANCE=4         chunks shown in the 3D view
# MC_VIEWER_PIXEL_RATIO=1      3D resolution: 1 is fastest, 0 uses the screen's own

# --- Cheats -----------------------------------------------------------------
# ENABLE_FULLBRIGHT=true       true: no torches needed before going underground
# ENABLE_XRAY=false            true: tunnels straight to ore hidden in rock (a cheat)
# XRAY_RADIUS=64

# --- Tuning -----------------------------------------------------------------
# TYPESAFE_TIMEOUT_MS=4000             longest a Jev request may take
# TYPESAFE_COMBAT_DEADLINE_MS=300      longest a fight waits for an answer
# TYPESAFE_REFLEX_RANGE=5              closer than this, no waiting at all
# TYPESAFE_RESOURCE_DEADLINE_MS=400    longest mining waits for an answer
# STATUS_INTERVAL_MS=15000             how often a status line prints
